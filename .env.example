# Copia questo file in `.env` e compila i valori mancanti.
# `.env` è ignorato da git: non committare mai chiavi reali.

# Porta del server demo (default: 3000)
PORT=3000

# Contatto (email o URL) aggiunto allo User-Agent. Fortemente consigliato per Wikimedia.
# Esempio: PHOTOFINDER_CONTACT=dev@example.com
PHOTOFINDER_CONTACT=

# Smithsonian Open Access (EDAN): chiave gratuita da https://edan.si.edu/openaccess/apidocs/
SMITHSONIAN_API_KEY=

# Pixabay: chiave gratuita da https://pixabay.com/api/docs/
PIXABAY_API_KEY=
